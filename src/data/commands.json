  {
    "id": "command-npkg",
    "name": "npkg",
    "command": "npkg <command> [args]",
    "usage": "npkg <command> [args]",
    "description": "Manage the current Nix profile",
    "type": "function",
    "category": "packages",
    "source": "lib/functions-nix.zsh",
    "availability": "Available when nix is installed",
    "dependencies": "nix; jq and fzf 0.68.0+ for optional workflows",
    "examples": [
      "npkg add bat",
      "npkg find nvim",
      "npkg remove",
      "npkg outdated",
      "npkg refresh",
      "npkg upgrade",
      "npkg search ripgrep"
    ],
    "features": [
      "add [pkg ...]        Add package(s); with no args opens an fzf picker",
      "install [pkg ...]    Alias for add",
      "find [query]         Fuzzy-pick nixpkgs attribute names and add selections",
      "search <query>       Run a plain nixpkgs search with descriptions",
      "list                 List packages in the current profile",
      "remove [pkg ...]     Remove package(s); with no args opens an fzf picker",
      "outdated             Compare installed and evaluated Nix output identities",
      "refresh              Rebuild the cached nixpkgs attribute index",
      "upgrade [pkg ...]    Upgrade all packages or only the named ones",
      "help                 Show this help text"
    ],
    "notes": [
      "Bare install names are expanded to nixpkgs#<name>",
      "npkg find searches a cached list of nixpkgs attribute names",
      "npkg refresh and outdated need jq",
      "Interactive add/find/remove needs jq and fzf 0.68.0+",
      "Advanced nix flags can be passed through by calling nix directly"
    ],
    "canonical": "npkg",
    "mutation": "mixed"
  },

  {
    "id": "command-039",
    "name": "cgm",
    "command": "cgm <command> [credential ...]",
    "usage": "cgm <command> [credential ...]",
    "description": "Store and load shell credentials securely",
    "type": "function",
    "category": "security",
    "source": "62-cgm.zsh",
    "availability": "Available when secret-tool and a Secret Service provider are available",
    "dependencies": "secret-tool and a Secret Service provider",
    "examples": [
      "cgm env OPENAI_KEY"
    ],
    "features": [
      "set <name>          Securely store or replace one credential",
      "list                List saved names without retrieving values",
      "env <name ...>      Load selected credentials into this shell",
      "env --all           Load every saved credential into this shell",
      "unset <name ...>    Remove selected variables from this shell",
      "delete <name ...>   Delete stored credentials and unset them here",
      "help                Show this help text"
    ],
    "notes": [
      "Secrets are stored by Linux Secret Service through secret-tool.",
      "cgm list and completion use credential names only; values stay hidden.",
      "cgm env changes this shell and child processes started afterward.",
      "Other open shells and already-running processes are not changed.",
      "cgm delete returns nonzero if a current-shell variable cannot be unset."
    ],
    "plainMode": true,
    "richOutput": true
  },
  {
    "id": "command-040",
    "name": "upkg",
    "command": "upkg [command] [args] [flags]",
    "usage": "upkg [command] [args] [flags]",
    "description": "Check, search, upgrade, and clean detected managers",
    "type": "function",
    "category": "packages",
    "source": "60-functions.zsh",
    "availability": "Available when at least one supported package manager is installed",
    "dependencies": "a supported package manager",
    "examples": [
      "upkg                                  # check for outdated packages",
      "upkg search ripgrep                  # compare package search matches",
      "upkg --only brew,npm                 # check selected managers",
      "upkg plan                            # preview upgrades",
      "upkg upgrade --dry-run --only npm    # preview selected upgrades",
      "upkg upgrade --sudo --only apt       # run a privileged backend",
      "upkg clean --dry-run --only brew,npm # preview manager-owned cleanup",
      "upkg clean --sudo --only apt         # remove unused APT data",
      "upkg managers --only npm,flatpak     # inspect selected order",
      "upkg search ripgrep --only=apt,nix"
    ],
    "features": [
      "outdated            Show outdated packages across detected managers",
      "check               Alias for outdated",
      "list                Alias for outdated",
      "search <query>      Search package names across detected managers",
      "upgrade             Run upgrades across selected managers",
      "up                  Alias for upgrade",
      "update              Alias for upgrade",
      "plan                Preview available upgrades without changing packages",
      "clean               Remove unused packages and stale manager-owned caches",
      "managers            Show detected managers and alternates",
      "help                Show this help text"
    ],
    "notes": [
      "Flag: --only <list>       Comma-separated manager IDs to include",
      "Flag: --skip <list>       Comma-separated manager IDs to exclude",
      "Flag: --sudo              Authorize privileged upgrade and cleanup backends",
      "Flag: --dry-run           Preview upgrades or cleanup without changing packages",
      "Manager: apt, dnf, pacman, paru, brew, flatpak, nix, npm",
      "upkg with no command defaults to outdated",
      "search prints one compact table with a manager column",
      "plan and upgrade --dry-run use the read-only outdated checks",
      "clean is mutating; use clean --dry-run for a read-only preview",
      "cleanup uses conservative manager commands and never deletes app data or user config directly",
      "upgrades never inject sudo automatically",
      "paru upgrades require explicit --sudo opt-in but still run unprefixed",
      "brew upgrades run unprefixed and stay in Homebrew user space",
      "npm upgrades stay user-space only; upkg will not recommend sudo npm"
    ],
    "plainMode": true,
    "richOutput": true
  },
  {
    "id": "command-041",
    "name": "npkg",
    "command": "npkg <command> [args]",
    "usage": "npkg <command> [args]",
    "description": "Manage the current Nix profile",
    "type": "function",
    "category": "packages",
    "source": "60-functions.zsh",
    "availability": "Available when nix is installed",
    "dependencies": "nix; jq and fzf 0.52.0+ for optional workflows",
    "examples": [
      "npkg add bat",
      "npkg find nvim",
      "npkg remove",
      "npkg outdated",
      "npkg refresh",
      "npkg upgrade",
      "npkg search ripgrep"
    ],
    "features": [
      "add [pkg ...]        Add package(s); with no args opens an fzf picker",
      "install [pkg ...]    Alias for add",
      "find [query]         Fuzzy-pick nixpkgs attribute names and add selections",
      "search <query>       Run a plain nixpkgs search with descriptions",
      "list                 List packages in the current profile",
      "remove [pkg ...]     Remove package(s); with no args opens an fzf picker",
      "outdated             Compare installed and evaluated Nix output identities",
      "refresh              Rebuild the cached nixpkgs attribute index",
      "upgrade [pkg ...]    Upgrade all packages or only the named ones",
      "help                 Show this help text"
    ],
    "notes": [
      "Bare install names are expanded to nixpkgs#<name>",
      "npkg find searches a cached list of nixpkgs attribute names",
      "npkg refresh and outdated need jq",
      "Interactive add/find/remove needs jq and fzf 0.52.0+",
      "Advanced nix flags can be passed through by calling nix directly"
    ]
  },

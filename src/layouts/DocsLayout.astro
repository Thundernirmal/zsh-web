---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@/components/PageHeader.astro';
import DocsSearch from '@/components/docs/DocsSearch.astro';
import { ArrowLeftIcon, ArrowRightIcon, BookOpenIcon, ChevronDownIcon } from 'lucide-react';
import { guideTopics } from '../../scripts/docs-guide.mjs';
import source from '@/data/source.json';
import legacyLinks from '@/data/docs-links.json';
import '../styles/docs.css';

interface Props {
  title: string;
  description: string;
  slug: string;
  headings: { depth: number; slug: string; text: string }[];
}
const { title, description, slug, headings } = Astro.props;
const overview = slug === 'index';
const pages = [{ slug: 'index', title: 'Overview' }, ...guideTopics];
const position = pages.findIndex((page) => page.slug === slug);
const previous = pages[position - 1];
const next = pages[position + 1];
const url = (page: { slug: string }) => page.slug === 'index' ? '/docs/' : `/docs/${page.slug}/`;
const topic = guideTopics.find((page) => page.slug === slug);
---

<Layout title={title} description={description}>
  <div class="docs-heading">
    <nav aria-label="Breadcrumb" class="docs-breadcrumb">
      {overview ? <span>Documentation</span> : <a href="/docs/">← Back to the shell guide</a>}
      {!overview && <><span aria-hidden="true">/</span><span>{String(position).padStart(2, '0')}</span></>}
    </nav>
    <PageHeader title={title} accent={overview ? 'guide' : undefined} id="_top">
      <p>{overview ? 'Setup, everyday workflows, and the details behind your commands.' : topic?.description}</p>
    </PageHeader>
  </div>

  <div class="docs-grid" data-docs-layout>
    <aside class="docs-sidebar">
      <details class="docs-menu" open data-docs-menu>
        <summary><BookOpenIcon className="size-4 text-primary" aria-hidden="true" /><span>Browse the guide</span><ChevronDownIcon className="docs-menu-chevron size-4" aria-hidden="true" /></summary>
        <nav aria-label="Guide navigation" class="docs-topic-nav">
          {pages.map((page, index) => <a href={url(page)} aria-current={page.slug === slug ? 'page' : undefined}>
            <span class="docs-topic-number" aria-hidden="true">{index === 0 ? '—' : String(index).padStart(2, '0')}</span><span>{page.title}</span>
          </a>)}
        </nav>
      </details>
    </aside>

    <div class="docs-reading">
      <DocsSearch />
      {!overview && headings.length > 0 && <details class="docs-outline">
        <summary>On this page<ChevronDownIcon className="size-4" aria-hidden="true" /></summary>
        <nav aria-label="On this page">
          {headings.filter((heading) => heading.depth <= 3).map((heading) => <a href={`#${heading.slug}`} class:list={{ 'docs-outline-nested': heading.depth > 2 }}>{heading.text}</a>)}
        </nav>
      </details>}

      <article class="markdown-doc" aria-label={title}><slot /></article>

      {overview && <section class="docs-topics" aria-labelledby="explore-the-guide">
        <div class="docs-section-heading"><h2 id="explore-the-guide">Explore the guide</h2><span>10 topics</span></div>
        <div class="docs-card-grid">
          {guideTopics.map((page, index) => <a class="docs-topic-card" href={url(page)}>
            <div><span class="docs-card-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span aria-hidden="true">↗</span></div>
            <h3>{page.title}</h3><p>{page.description}</p>
          </a>)}
        </div>
        <div id="command-reference" class="docs-reference-links"><a class="text-link" href="/commands/">Browse searchable commands</a><span aria-hidden="true">·</span><a class="text-link" href="/tips/">Explore shell tips</a></div>
      </section>}

      <aside class="docs-snapshot" aria-label="Documentation source">
        <span>Documentation snapshot</span><a href={`${source.repository}/tree/${source.commit}`}>{source.commit.slice(0, 8)}</a><a class="text-link" href={`${source.repository}/blob/${source.commit}/GUIDE.md`}>View GUIDE.md source</a>
      </aside>

      <nav class="docs-pagination" aria-label="Guide pagination">
        {previous ? <a href={url(previous)}><ArrowLeftIcon className="size-4" aria-hidden="true" /><div><span>Previous</span><strong>{previous.title}</strong></div></a> : <span></span>}
        {next && <a href={url(next)} class="docs-pagination-next"><div><span>Next</span><strong>{next.title}</strong></div><ArrowRightIcon className="size-4" aria-hidden="true" /></a>}
      </nav>
    </div>
  </div>
  {overview && <div hidden data-guide-links={JSON.stringify(legacyLinks)}></div>}
</Layout>

<script>
  const initDocs = () => {
    const menu = document.querySelector<HTMLDetailsElement>('[data-docs-menu]');
    if (menu) {
      menu.open = matchMedia('(min-width: 1024px)').matches;
      menu.dataset.ready = 'true';
    }
    document.querySelectorAll<HTMLElement>('.markdown-doc :is(table, pre)').forEach((element) => { element.tabIndex = 0; });
    const legacy = document.querySelector<HTMLElement>('[data-guide-links]');
    if (!legacy || !location.hash) return;
    const links = JSON.parse(legacy.dataset.guideLinks ?? '{}') as Record<string, string>;
    let anchor: string;
    try { anchor = decodeURIComponent(location.hash.slice(1)); } catch { return; }
    if (Object.hasOwn(links, anchor)) location.replace(links[anchor]);
  };
  const wide = matchMedia('(min-width: 1024px)');
  wide.addEventListener('change', () => {
    const menu = document.querySelector<HTMLDetailsElement>('[data-docs-menu]');
    if (menu) menu.open = wide.matches;
  });
  document.addEventListener('focusin', (event) => {
    const link = event.target instanceof Element ? event.target.closest<HTMLElement>('.docs-topic-nav a') : null;
    // Firefox can leave a tall focused link only partially visible in a scrollport.
    if (wide.matches && link) requestAnimationFrame(() => {
      if (link === document.activeElement) link.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'instant' });
    });
  });
  document.addEventListener('astro:page-load', initDocs);
  window.addEventListener('hashchange', () => {
    if (document.querySelector('[data-guide-links]')) initDocs();
  });
  initDocs();
</script>

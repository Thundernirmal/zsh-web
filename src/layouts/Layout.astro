---
import '../styles/global.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import outfitFont from '@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url';
import jakartaFont from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import jetbrainsFont from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

interface Props {
	title: string;
	description?: string;
}

const defaultDescription = "A living guide to aliases, functions, tips, and workflows from Nirmal Katariya's shell environment.";
const { title, description = defaultDescription } = Astro.props;
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
const pageTitle = isHome ? "Nirmal's Shell" : `${title} | Nirmal's Shell`;
const canonicalUrl = new URL(currentPath, Astro.site ?? Astro.url);
const ogImageUrl = new URL('/og-image.png', Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="preload" href={outfitFont} as="font" type="font/woff2" crossorigin="anonymous" />
		<link rel="preload" href={jakartaFont} as="font" type="font/woff2" crossorigin="anonymous" />
		{isHome && (
			/* JetBrains Mono serves the above-the-fold hero code; elsewhere it loads lazily on first use. */
			<link rel="preload" href={jetbrainsFont} as="font" type="font/woff2" crossorigin="anonymous" />
		)}
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#1e1e2e" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content="Nirmal's Shell" />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Nirmal's Shell — terminal guide to aliases and functions" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={ogImageUrl} />
		<link rel="canonical" href={canonicalUrl} />
		<title>{pageTitle}</title>
		<ClientRouter />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<div class="flex min-h-screen w-full flex-col">
			<Header />
			<main
				id="main-content"
				tabindex="-1"
				transition:name="page-content"
				transition:animate="fade"
				class="content-shell grid grid-cols-[minmax(0,1fr)] flex-1 content-start gap-6 py-8 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring sm:gap-8 sm:py-14"
			>
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>

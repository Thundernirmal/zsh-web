---
import source from '@/data/source.json';
import { Separator } from '@/components/ui/separator';

// Format the commit's own calendar date (as written in its offset), not the
// build machine's: UTC midnight of that date formatted in UTC never shifts.
const sourceDay = source.sourceDate.slice(0, 10);
const sourceDateLabel = new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(`${sourceDay}T00:00:00Z`));
---

<footer class="w-full" transition:name="site-footer" transition:animate="none">
	<Separator />
	<div class="content-shell py-5 text-sm leading-6 text-muted-foreground">
		<p class="flex flex-wrap items-center gap-x-2 gap-y-1">
			Built by <a class="footer-link" href="https://nirmalkatariya.com">Nirmal Katariya</a>
			<span aria-hidden="true">·</span>
			<a class="footer-link" href="https://github.com/Thundernirmal/zsh" target="_blank" rel="noopener noreferrer">Source Config<span class="sr-only"> (opens in a new tab)</span></a>
			<span aria-hidden="true">·</span>
			<a class="footer-link" href="/get-started/">Get Started</a>
            <span aria-hidden="true">·</span>
            <a class="footer-link" href="/docs/">Docs</a>
            <span aria-hidden="true">·</span>
            <a class="footer-link" href="/troubleshooting/">Troubleshooting</a>
		</p>
    <p>Generated from shell commit <a class="footer-link" href={`${source.repository}/tree/${source.commit}`}>{source.commit.slice(0, 8)}</a> · Source updated <time datetime={sourceDay}>{sourceDateLabel}</time></p>
	</div>
</footer>

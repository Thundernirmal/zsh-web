---
import { RefreshCwIcon } from 'lucide-react';
import { CategoryIcon } from '@/components/CategoryBadge';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { categoryLabels, categoryOrder, categoryTokens } from '@/lib/categories';

const rouletteCategories = categoryOrder;
---

<div
	class="flex h-full flex-1 flex-col justify-between gap-4"
	data-tip-roulette
	data-category-labels={JSON.stringify(categoryLabels)}
	data-category-tokens={JSON.stringify(categoryTokens)}
>
	<div class="sr-only" aria-live="polite" aria-atomic="true" data-tip-announcement></div>

	<div class="grid gap-3">
		<div class="flex min-h-[5.5rem] items-center border-l-2 border-primary py-2 pl-3">
			<p class="text-pretty text-base leading-7 text-foreground transition-[opacity,transform] duration-150 motion-reduce:transition-none" data-tip-text>
				Choose Show Random Tip to explore shell shortcuts, functions, and keybindings.
			</p>
		</div>

		<a class="footer-link w-fit" data-tip-reference href="/commands/" hidden>Read command reference</a>
		<div class="grid gap-1.5" data-tip-metadata>
			<div class="flex min-h-6 flex-wrap items-center gap-x-1.5 gap-y-1">
				<span class="contents" data-tip-placeholders aria-hidden="true">
					<Badge variant="placeholder" data-tip-placeholder-category>Category</Badge>
					<Badge variant="placeholder" data-tip-placeholder-source>Source</Badge>
				</span>
				<span class="inline-flex" data-tip-category-wrapper hidden>
					<Badge variant="outline" className="roulette-category" data-tip-category>
						{rouletteCategories.map((category) => (
							<CategoryIcon category={category} className="hidden" data-icon="inline-start" data-tip-category-icon={category} />
						))}
						<CategoryIcon category="all" className="hidden" data-icon="inline-start" data-tip-category-icon="fallback" />
						<span data-tip-category-label></span>
					</Badge>
				</span>
				<span class="inline-flex" data-tip-source-wrapper hidden>
					<Badge variant="metadata" data-tip-source></Badge>
				</span>
			</div>
			<div class="min-h-10" data-tip-availability-wrapper>
				<span class="block text-pretty text-sm leading-5 text-muted-foreground" data-tip-placeholder-hint>
					Extracted from <code class="font-mono text-xs text-foreground/80">~/.config/zsh</code> with dependency and availability notes.
				</span>
				<span class="block text-pretty text-sm leading-5 text-muted-foreground" data-tip-availability hidden></span>
			</div>
		</div>
	</div>

	<button
		type="button"
		class:list={[buttonVariants({ variant: 'secondary', size: 'lg' }), 'w-full sm:w-auto']}
		data-tip-action
	>
		<RefreshCwIcon data-icon="inline-start" aria-hidden="true" />
		<span data-tip-action-label>Show Random Tip</span>
	</button>
</div>

<script>
	import { commandHref, formatLabel } from '@/lib/shell-docs';

	interface ShellTip {
		text: string;
		category: string;
		source?: string;
		availability?: string;
		commandId?: string;
		commandName?: string;
	}

	let tipsPromise: Promise<ShellTip[]> | undefined;
	let cleanUpRoulette: (() => void) | undefined;

	const loadTips = () => {
		tipsPromise ??= fetch('/tips.json')
			.then((response) => {
				if (!response.ok) throw new Error('Unable to load tips');
				return response.json() as Promise<ShellTip[]>;
			})
			.catch((error) => {
				tipsPromise = undefined;
				throw error;
			});

		return tipsPromise;
	};

	const setupRoulette = () => {
		cleanUpRoulette?.();

		const root = document.querySelector<HTMLElement>('[data-tip-roulette]');
		const text = root?.querySelector<HTMLElement>('[data-tip-text]');
		const reference = root?.querySelector<HTMLAnchorElement>('[data-tip-reference]');
		const announcement = root?.querySelector<HTMLElement>('[data-tip-announcement]');
		const placeholders = root?.querySelector<HTMLElement>('[data-tip-placeholders]');
		const placeholderHint = root?.querySelector<HTMLElement>('[data-tip-placeholder-hint]');
		const category = root?.querySelector<HTMLElement>('[data-tip-category]');
		const categoryWrapper = root?.querySelector<HTMLElement>('[data-tip-category-wrapper]');
		const categoryLabel = root?.querySelector<HTMLElement>('[data-tip-category-label]');
		const categoryIcons = Array.from(root?.querySelectorAll<SVGElement>('[data-tip-category-icon]') ?? []);
		const source = root?.querySelector<HTMLElement>('[data-tip-source]');
		const sourceWrapper = root?.querySelector<HTMLElement>('[data-tip-source-wrapper]');
		const availability = root?.querySelector<HTMLElement>('[data-tip-availability]');
		const action = root?.querySelector<HTMLButtonElement>('[data-tip-action]');
		const actionLabel = root?.querySelector<HTMLElement>('[data-tip-action-label]');

		if (!root || !text || !announcement || !placeholders || !category || !categoryWrapper || !categoryLabel || !source || !sourceWrapper || !availability || !action || !actionLabel) return;

		const categoryLabels: Record<string, string> = JSON.parse(root.dataset.categoryLabels ?? '{}');
		const categoryTokens: Record<string, string> = JSON.parse(root.dataset.categoryTokens ?? '{}');

		const controller = new AbortController();
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		let interval = 0;
		let finalTip: ShellTip | undefined;
		let spinning = false;

		const showTip = (tip: ShellTip, announce = false) => {
			text.textContent = tip.text;
            if (reference) {
              reference.hidden = !tip.commandId;
              reference.textContent = tip.commandName ? `Read ${tip.commandName} reference` : '';
              if (tip.commandId) reference.href = commandHref({ id: tip.commandId });
              else reference.removeAttribute('href');
            }
			const token = categoryTokens[tip.category] ?? tip.category;
			category.style.setProperty('--roulette-category', `var(--category-${token})`);
			category.dataset.category = tip.category;
			categoryLabel.textContent = categoryLabels[tip.category] ?? formatLabel(tip.category);
			const selectedIcon = categoryIcons.find((icon) => icon.dataset.tipCategoryIcon === tip.category)
				?? categoryIcons.find((icon) => icon.dataset.tipCategoryIcon === 'fallback');
			categoryIcons.forEach((icon) => icon.classList.toggle('hidden', icon !== selectedIcon));
			placeholders.hidden = true;
			if (placeholderHint) placeholderHint.hidden = true;
			categoryWrapper.hidden = false;

			source.textContent = tip.source ? formatLabel(tip.source) : '';
			sourceWrapper.hidden = !tip.source;
			availability.textContent = tip.availability ?? '';
			availability.hidden = !tip.availability;

			if (announce) announcement.textContent = tip.text;
		};

		const finish = (tip: ShellTip) => {
			if (interval) window.clearInterval(interval);
			interval = 0;
			spinning = false;
			finalTip = undefined;
			showTip(tip, true);
			actionLabel.textContent = 'Show Random Tip';
		};

		const spin = async () => {
			if (spinning && finalTip) {
				finish(finalTip);
				return;
			}

			action.disabled = true;
			actionLabel.textContent = 'Loading…';

			try {
				const tips = await loadTips();
				if (controller.signal.aborted) return;
				if (tips.length === 0) throw new Error('No tips available');

				finalTip = tips[Math.floor(Math.random() * tips.length)];
				if (reducedMotion.matches) {
					finish(finalTip);
					return;
				}

				spinning = true;
				actionLabel.textContent = 'Show Tip Now';
				let iterations = 0;
				interval = window.setInterval(() => {
					showTip(tips[Math.floor(Math.random() * tips.length)]);
					iterations += 1;
					if (iterations >= 12 && finalTip) finish(finalTip);
				}, 80);
			} catch {
				if (controller.signal.aborted) return;
				text.textContent = 'Tips could not be loaded. Try again.';
				announcement.textContent = text.textContent;
				actionLabel.textContent = 'Try Again';
			} finally {
				if (!controller.signal.aborted) action.disabled = false;
			}
		};

		action.addEventListener('click', spin, { signal: controller.signal });

		cleanUpRoulette = () => {
			controller.abort();
			if (interval) window.clearInterval(interval);
		};
	};

	document.addEventListener('astro:page-load', setupRoulette);
	document.addEventListener('astro:before-swap', () => cleanUpRoulette?.());
	if (document.readyState !== 'loading') setupRoulette();
</script>

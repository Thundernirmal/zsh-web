---
import { ChevronRightIcon } from 'lucide-react';

interface Props {
    cursor?: boolean;
}

const { cursor = false } = Astro.props;
---

<span class="whitespace-nowrap"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="mr-2 inline-block size-[1.1em] text-muted-foreground align-[-0.12em]" aria-hidden="true"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="3" /><g fill="var(--terminal-background)" stroke="var(--terminal-background)" stroke-width="1.5"><circle cx="17.7" cy="6.3" r="3.1" /><circle cx="4.3" cy="9.9" r="3.1" /><circle cx="14.1" cy="19.7" r="3.1" /></g><g fill="currentColor"><circle cx="17.7" cy="6.3" r="1.9" /><circle cx="4.3" cy="9.9" r="1.9" /><circle cx="14.1" cy="19.7" r="1.9" /></g></svg><span class="text-category-navigation">nirmal@Tiger</span><span class="ml-2 text-category-pipe">~</span><ChevronRightIcon className="mx-2 inline-block size-[1.1em] text-muted-foreground align-[-0.18em]" aria-hidden="true" /></span>{cursor ? <span class="inline-block h-[1.25em] w-2.5 translate-y-[0.2em] bg-category-packages motion-safe:animate-pulse" aria-hidden="true"></span> : <span class="text-foreground"><slot /></span>}

---
import { Card, CardContent } from '@/components/ui/card';
import type { LucideIcon } from 'lucide-react';

interface Props {
  value: string | number;
  label: string;
  icon: LucideIcon;
}

const { value, label, icon: Icon } = Astro.props;
---

<Card size="sm" className="min-w-0">
  <CardContent className="grid grid-cols-[minmax(0,1fr)_auto] items-start gap-x-3 gap-y-0.5">
    <p class="font-heading text-3xl font-semibold leading-none text-primary tabular-nums">{value}</p>
    <span class="flex size-8 items-center justify-center rounded-lg bg-secondary text-muted-foreground" aria-hidden="true">
      <Icon className="size-4" aria-hidden="true" />
    </span>
    <p class="col-span-2 text-base leading-snug text-muted-foreground">{label}</p>
  </CardContent>
</Card>

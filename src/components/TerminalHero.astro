---
interface Props {
    featuredTip: string;
    upkgExample: string;
    npkgExample: string;
}

const { featuredTip, upkgExample, npkgExample } = Astro.props;
import { Card, CardContent, CardHeader } from '@/components/ui/card';
---

<figure class="motion-safe:animate-in motion-safe:fade-in motion-safe:slide-in-from-bottom-2">
    <figcaption class="sr-only">Terminal demonstration showing example shell commands and their output.</figcaption>
    <Card className="gap-0 py-0 [--card-spacing:--spacing(3)]">
        <CardHeader className="grid grid-cols-[auto_1fr_auto] items-center gap-2 rounded-none border-b bg-muted/50 px-4 py-3">
            <span class="flex gap-2" aria-hidden="true">
                <span class="size-2.5 rounded-full bg-destructive"></span>
                <span class="size-2.5 rounded-full bg-category-globbing"></span>
                <span class="size-2.5 rounded-full bg-category-search"></span>
            </span>
            <span class="text-center font-mono text-xs text-muted-foreground">~/.config/zsh</span>
            <span class="w-12" aria-hidden="true"></span>
        </CardHeader>
        <CardContent className="overflow-hidden bg-background/70 p-0">
            <pre class="overflow-x-auto whitespace-pre-wrap break-words p-5 text-xs leading-6 sm:text-sm"><code><span class="block"><span class="text-primary">❯ </span><span class="text-category-search">tips</span></span><span class="block text-muted-foreground">tip: {featuredTip}</span><span class="block" aria-hidden="true">&nbsp;</span><span class="block"><span class="text-primary">❯ </span><span class="text-category-search">{upkgExample}</span></span><span class="block text-muted-foreground">manager   package    summary</span><span class="block text-muted-foreground">brew      ripgrep    Search package names across detected managers</span><span class="block" aria-hidden="true">&nbsp;</span><span class="block"><span class="text-primary">❯ </span><span class="text-category-search">{npkgExample}</span></span><span class="block text-muted-foreground">Interactive picker ready with preview metadata</span></code></pre>
        </CardContent>
    </Card>
</figure>

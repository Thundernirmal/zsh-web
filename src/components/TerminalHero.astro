---
interface Props {
    featuredTip: string;
    upkgExample: string;
    npkgExample: string;
}

const { featuredTip, upkgExample, npkgExample } = Astro.props;
// The example's aligned "# comment" wraps onto its own line on phones, where it
// reads like a second command; show it only where it fits beside the command.
const [, upkgCommand = upkgExample, upkgComment] = upkgExample.match(/^(.*?)(\s+#\s.*)$/) ?? [];
import TerminalWindow from '@/components/TerminalWindow.astro';
import TerminalPrompt from '@/components/TerminalPrompt.astro';
---

<figure class="motion-safe:animate-in motion-safe:fade-in motion-safe:slide-in-from-bottom-2">
    <figcaption class="sr-only">Terminal demonstration showing example shell commands and their output.</figcaption>
    <TerminalWindow title="nirmal@Tiger: ~">
        <pre class="terminal-body" translate="no"><code><span class="block"><TerminalPrompt>tips</TerminalPrompt></span><span class="block"><span class="text-primary">tip:</span> <span class="text-muted-foreground">{featuredTip}</span></span><span class="block h-3" aria-hidden="true"></span><span class="block"><TerminalPrompt>{upkgCommand}{upkgComment && <span class="hidden text-muted-foreground sm:inline">{upkgComment}</span>}</TerminalPrompt></span><span class="hidden text-muted-foreground sm:block">manager   package    summary</span><span class="hidden sm:block"><span class="text-category-git">dnf</span>       <span class="text-category-search">ripgrep</span>    <span class="text-muted-foreground">Search package names across detected managers</span></span><span class="hidden h-3 sm:block" aria-hidden="true"></span><span class="hidden sm:block"><TerminalPrompt>{npkgExample}</TerminalPrompt></span><span class="hidden text-muted-foreground sm:block">Interactive picker ready with preview metadata</span><span class="block h-3 sm:hidden" aria-hidden="true"></span><span class="block"><TerminalPrompt cursor /></span></code></pre>
    </TerminalWindow>
</figure>

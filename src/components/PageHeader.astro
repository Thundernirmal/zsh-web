---
interface Props {
  title: string;
  accent?: string;
  hero?: boolean;
  id?: string;
  /** Set for identifiers (e.g. command names) that machine translation must not alter. */
  translate?: 'no';
}

const { title, accent, hero = false, id, translate } = Astro.props;
const accentIndex = accent ? title.indexOf(accent) : -1;
const titleBeforeAccent = accentIndex >= 0 ? title.slice(0, accentIndex) : "";
const titleAfterAccent = accentIndex >= 0 ? title.slice(accentIndex + (accent?.length ?? 0)) : "";
---

<header id={id} class="grid max-w-3xl gap-4 sm:gap-5 motion-safe:animate-in motion-safe:fade-in motion-safe:slide-in-from-bottom-2">
  <h1
    translate={translate}
    class:list={[
      "display text-balance text-foreground",
      hero
        ? "text-[clamp(3rem,10vw,5.5rem)]"
        : "text-[2.75rem] sm:text-6xl",
    ]}
  >
    {
      accentIndex >= 0 ? (
        <>
          {titleBeforeAccent}<span class="text-primary">{accent}</span>{titleAfterAccent}
        </>
      ) : (
        title
      )
    }{hero && <span class="text-primary" aria-hidden="true">.</span>}
  </h1>
  <div class="text-pretty text-base leading-7 text-muted-foreground sm:text-lg">
    <slot />
  </div>
</header>

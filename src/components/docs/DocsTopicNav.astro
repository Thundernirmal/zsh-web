---
import { guideNavigationTitle, guidePages, guideUrl } from '@/lib/guide-topics.mjs';
interface Props {
  slug: string;
  /** Current-page sections, listed under the active topic (desktop sidebar only). */
  sections?: { depth: number; slug: string; text: string }[];
}
const { slug, sections = [] } = Astro.props;
---
<nav aria-label="Guide navigation" class="docs-topic-nav">
  {guidePages.map((page, index) => <>
    <a href={guideUrl(page.slug)} aria-current={page.slug === slug ? 'page' : undefined} data-topic-link>
      <span class="docs-topic-number" aria-hidden="true">{index === 0 ? '—' : String(index).padStart(2, '0')}</span>{guideNavigationTitle(page)}
    </a>
    {page.slug === slug && sections.length > 0 && <ul class="docs-topic-sections" aria-label="On this page">
      {sections.map((heading) => <li><a href={`#${heading.slug}`} class:list={{ 'docs-outline-nested': heading.depth > 2 }}>{heading.text}</a></li>)}
    </ul>}
  </>)}
</nav>

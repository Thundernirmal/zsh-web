---
import Head from '@astrojs/starlight/components/Head.astro';
import outfit from '@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url';
import jakarta from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
---

<Head />
<meta name="color-scheme" content="dark" />
<meta name="theme-color" content="#1e1e2e" />
<link rel="preload" href={outfit} as="font" type="font/woff2" crossorigin="anonymous" />
<link rel="preload" href={jakarta} as="font" type="font/woff2" crossorigin="anonymous" />

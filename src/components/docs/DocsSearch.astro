---
import { SearchIcon } from 'lucide-react';
import { createHash } from 'node:crypto';
import index from '@/data/docs-search.json';
const version = createHash('sha256').update(JSON.stringify(index)).digest('hex').slice(0, 16);
---

<section class="docs-search" aria-label="Guide search" data-docs-search data-index-url={`/docs-search.json?v=${version}`}>
  <label><span>Search docs</span>
  <span class="docs-search-field">
    <SearchIcon className="size-4" aria-hidden="true" />
    <input id="docs-search-input" type="search" name="q" placeholder="Find a workflow, command, or requirement…" autocomplete="off" aria-describedby="docs-search-status" disabled />
    <kbd aria-hidden="true">/</kbd>
  </span></label>
  <div class="docs-search-feedback">
    <p id="docs-search-status" role="status" data-search-status>Guide search is loading. Browse the topics below.</p>
    <button type="button" data-search-clear hidden>Clear search</button>
    <a href={Astro.url.pathname} data-astro-reload data-search-reload hidden>Reload search</a>
  </div>
  <div data-search-panel hidden><ul aria-label="Guide search results" data-search-results></ul></div>
  <div data-search-error hidden><p role="alert">Couldn’t load guide search. Browse the topics or try again.</p><button type="button" data-search-retry>Retry search</button></div>
  <template data-search-template><li><a href="/docs/" class="docs-search-result"><strong></strong><span></span></a></li></template>
</section>

<noscript><style is:inline>[data-docs-search] { display: none; }</style><p>Guide search requires JavaScript. Browse the guide topics.</p></noscript>
<script is:inline data-astro-rerun>
  {
    const root = document.querySelector('[data-docs-search]');
    setTimeout(() => {
      if (root?.isConnected && !root.dataset.ready) {
        root.querySelector('[data-search-status]').textContent = 'Couldn’t initialize guide search. Reload or browse the topics.';
        const reload = root.querySelector('[data-search-reload]');
        reload.href = location.href;
        reload.hidden = false;
      }
    }, 10000);
  }
</script>

---
import PageTitle from '@astrojs/starlight/components/PageTitle.astro';
import source from '@/data/source.json';
import links from '@/data/docs-links.json';
const isOverview = Astro.url.pathname.replace(/\/$/, '') === '/docs';
---

<PageTitle />
<aside class="source-snapshot" aria-label="Documentation source" data-pagefind-ignore>
  <p>Documentation snapshot</p>
  <p>Shell commit <a href={`${source.repository}/tree/${source.commit}`}>{source.commit.slice(0, 8)}</a> · <a href={`${source.repository}/blob/${source.commit}/GUIDE.md`}>View GUIDE.md source</a></p>
  { !isOverview && <a href="/docs/">← Back to the shell guide</a> }
</aside>
{isOverview && <div hidden data-guide-links={JSON.stringify(links)}></div>}

<script>
  const restoreGuideAnchor = () => {
    const node = document.querySelector<HTMLElement>('[data-guide-links]');
    if (!node || !location.hash) return;
    const destinations = JSON.parse(node.dataset.guideLinks ?? '{}') as Record<string, string>;
    let anchor: string;
    try { anchor = decodeURIComponent(location.hash.slice(1)); } catch { return; }
    const destination = Object.hasOwn(destinations, anchor) ? destinations[anchor] : undefined;
    if (destination) location.replace(destination);
  };
  document.querySelectorAll<HTMLElement>('.sl-markdown-content :is(table, pre)').forEach((node) => { node.tabIndex = 0; });
  restoreGuideAnchor();
  window.addEventListener('hashchange', restoreGuideAnchor);
</script>

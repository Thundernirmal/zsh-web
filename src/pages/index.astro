---
import Layout from '../layouts/Layout.astro';
import TerminalHero from '../components/TerminalHero.astro';
import TipRoulette from '../components/TipRoulette.astro';
import PageHeader from '../components/PageHeader.astro';
import { BookOpenIcon } from 'lucide-react';
import { buttonVariants } from '@/components/ui/button';
import { getCollection } from 'astro:content';

const commands = (await getCollection('commands')).map(({ data }) => data);
const tips = (await getCollection('tips')).map(({ data }) => data);
const categoryCount = new Set(commands.map((command) => command.category).filter(Boolean)).size;
const featuredTip = tips.find((tip) => tip.source === 'upkg')?.text ?? tips[0]?.text ?? 'Run tips again for another hint';
const upkgExamples = commands.find((command) => command.name === 'upkg')?.examples ?? [];
const upkgExample = upkgExamples.find((example) => example.includes('search')) ?? upkgExamples[0] ?? 'upkg search ripgrep';
const npkgExample = commands.find((command) => command.name === 'npkg')?.examples?.[1] ?? 'npkg find nvim';
---

<Layout title="Home">
	<PageHeader id="home-page-header" title="Nirmal's Shell" hero>
		<p>
			A living guide to aliases, functions, tips, and workflows, extracted directly from the{' '}
			<a href="https://github.com/Thundernirmal/zsh" target="_blank" rel="noopener noreferrer" class="text-link" translate="no">Thundernirmal/zsh<span class="sr-only"> (opens in a new tab)</span></a>{' '}
			repository.
		</p>
	</PageHeader>
    <div class="flex flex-wrap gap-3 motion-safe:animate-in motion-safe:fade-in motion-safe:slide-in-from-bottom-2">
      <a href="/get-started/" class={buttonVariants({ size: 'lg' })}>Get Started</a>
      <a href="/docs/" class={buttonVariants({ variant: 'outline', size: 'lg' })}>Read Docs <BookOpenIcon data-icon="inline-end" aria-hidden="true" /></a>
    </div>

	<div>
		<TerminalHero featuredTip={featuredTip} upkgExample={upkgExample} npkgExample={npkgExample} />
	</div>

	{/* The portfolio's playground band: numbered cells divided by hairline rules, each ending in a label link. */}
	<div class="home-band motion-safe:animate-in motion-safe:fade-in motion-safe:slide-in-from-bottom-2">
		<section class="home-cell" aria-labelledby="home-commands">
			<p class="label" aria-hidden="true"><span class="text-category-search">01</span> / Commands</p>
			<h2 id="home-commands" class="display text-4xl sm:text-5xl">Command Library</h2>
			<div class="grid flex-1 content-start gap-3 leading-7 text-muted-foreground">
				<p>
					Search {commands.length} commands across {categoryCount} categories, including extracted usage, examples, requirements, and feature notes from the committed shell snapshot.
				</p>
				<p>
					From <code translate="no">upkg search ripgrep</code> to <code translate="no">npkg add bat</code>, quick aliases like <code translate="no">ll</code> and <code translate="no">lt</code>, and more — all documented with usage, options, and availability notes.
				</p>
				<p>
					Filter by type — aliases, global aliases, or functions — and search instantly with results synced to the URL for easy sharing.
				</p>
			</div>
			<a href="/commands" class="home-cta label">Explore the Reference <span class="home-cta-arrow" aria-hidden="true">→</span></a>
		</section>

		<section class="home-cell" aria-labelledby="home-tips">
			<p class="label" aria-hidden="true"><span class="text-category-git">02</span> / Tips</p>
			<h2 id="home-tips" class="display text-4xl sm:text-5xl">Shell Tips</h2>
			<p class="leading-7 text-muted-foreground">
				Review always-on shortcuts and conditional features side by side, with availability notes carried through from the zsh config.
			</p>
			<div class="flex flex-1 flex-col">
				<TipRoulette />
			</div>
			<a href="/tips" class="home-cta label">View All {tips.length} Tips <span class="home-cta-arrow" aria-hidden="true">→</span></a>
		</section>
	</div>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import TerminalHero from '../components/TerminalHero.astro';
import TipRoulette from '../components/TipRoulette.astro';
import PageHeader from '../components/PageHeader.astro';
import { ArrowRightIcon, LightbulbIcon, SquareTerminalIcon } from 'lucide-react';
import { buttonVariants } from '@/components/ui/button';
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from '@/components/ui/card';
import { getCollection } from 'astro:content';

const commands = (await getCollection('commands')).map(({ data }) => data);
const tips = (await getCollection('tips')).map(({ data }) => data);
const categoryCount = new Set(commands.map((command) => command.category).filter(Boolean)).size;
const featuredTip = tips.find((tip) => tip.source === 'upkg')?.text ?? tips[0]?.text ?? 'Run tips again for another hint';
const upkgExamples = commands.find((command) => command.name === 'upkg')?.examples ?? [];
const upkgExample = upkgExamples.find((example) => example.includes('search')) ?? upkgExamples[0] ?? 'upkg search ripgrep';
const npkgExample = commands.find((command) => command.name === 'npkg')?.examples?.[1] ?? 'npkg find nvim';
---

<Layout title="Home">
	<PageHeader id="home-page-header" title="Nirmal's Shell" accent="Nirmal's" hero>
		<p>
			A living guide to aliases, functions, tips, and workflows — extracted directly from:
			<a href="https://github.com/Thundernirmal/zsh" target="_blank" rel="noopener noreferrer" class="font-medium text-primary underline-offset-4 hover:underline" translate="no">
				github.com/Thundernirmal/zsh
				<span class="sr-only"> (opens in a new tab)</span>
			</a>
		</p>
	</PageHeader>
    <div class="flex flex-wrap gap-3">
      <a href="/commands/" class={buttonVariants({ size: 'lg' })}>Browse Commands</a>
      <a href="/get-started/" class={buttonVariants({ variant: 'outline', size: 'lg' })}>Get Started</a>
    </div>

	<div>
		<TerminalHero featuredTip={featuredTip} upkgExample={upkgExample} npkgExample={npkgExample} />
	</div>

	<div class="grid gap-4 motion-safe:animate-in motion-safe:fade-in motion-safe:slide-in-from-bottom-2 lg:grid-cols-2">
		<Card size="sm" className="flex flex-col">
				<CardHeader className="gap-2">
					<CardTitle><h2 class="flex items-center gap-2 text-xl"><SquareTerminalIcon className="size-5 text-primary" aria-hidden="true" />Command Library</h2></CardTitle>
					<CardDescription>
						Search {commands.length} commands across {categoryCount} categories, including extracted usage, examples, requirements, and feature notes from the committed shell snapshot.
					</CardDescription>
			</CardHeader>
			<CardContent className="grid flex-1 content-start gap-3 leading-6 text-muted-foreground">
				<p>
					From <code translate="no">upkg search ripgrep</code> to <code translate="no">npkg add bat</code>, quick aliases like <code translate="no">ll</code> and <code translate="no">lt</code>, and more — all documented with usage, options, and availability notes.
				</p>
				<p>
					Filter by type — aliases, global aliases, or functions — and search instantly with results synced to the URL for easy sharing.
				</p>
			</CardContent>
			<CardFooter>
				<a href="/commands" class={buttonVariants({ size: 'lg' })}>Explore the Reference <ArrowRightIcon data-icon="inline-end" aria-hidden="true" /></a>
			</CardFooter>
		</Card>

		<Card size="sm" className="flex flex-col">
				<CardHeader className="gap-2">
					<CardTitle><h2 class="flex items-center gap-2 text-xl"><LightbulbIcon className="size-5 text-primary" aria-hidden="true" />Shell Tips</h2></CardTitle>
					<CardDescription>
						Review always-on shortcuts and conditional features side by side, with availability notes carried through from the zsh config.
				</CardDescription>
			</CardHeader>
			<CardContent className="flex flex-1 flex-col">
				<TipRoulette />
			</CardContent>
			<CardFooter>
				<a href="/tips" class={buttonVariants({ size: 'lg' })}>View All {tips.length} Tips <ArrowRightIcon data-icon="inline-end" aria-hidden="true" /></a>
			</CardFooter>
		</Card>
	</div>
</Layout>

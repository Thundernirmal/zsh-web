---
import Layout from '../layouts/Layout.astro';
import TipsExplorer from '../components/TipsExplorer.tsx';
import PageHeader from '../components/PageHeader.astro';
import StatCard from '../components/StatCard.astro';
import tipsData from '../data/tips.json';

type Tip = { text: string; category: string; source?: string; availability?: string };
const tips: Tip[] = tipsData;
const conditionalCount = tips.filter((tip) => tip.availability && tip.availability !== 'Always available').length;
const sourceCount = new Set(tips.map((tip) => tip.source).filter(Boolean)).size;
---

<Layout title="Shell Tips">
	<PageHeader title="Shell Tips">
		<p>
			{tips.length} curated tips — shortcuts, workflows, and hidden features from <span class="font-medium text-primary">Nirmal's Shell</span>, including when conditional tools and integrations show up.
		</p>
	</PageHeader>

	<div class="grid gap-4">
		<div class="grid grid-cols-1 gap-2.5 motion-safe:animate-in motion-safe:fade-in sm:grid-cols-3">
			<StatCard value={tips.length} label="tip records" />
			<StatCard value={conditionalCount} label="conditional tips" />
			<StatCard value={sourceCount} label="tip sources" />
		</div>

		<TipsExplorer client:load tips={tips} />
	</div>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import TipsExplorer from '../components/TipsExplorer.tsx';
import PageHeader from '../components/PageHeader.astro';
import { getCollection } from 'astro:content';

const tips = (await getCollection('tips')).map(({ data }) => data);
---

<Layout title="Shell Tips" description={`Browse ${tips.length} searchable shell shortcuts and workflows, including dependency and availability notes.`}>
	<PageHeader title="Shell Tips">
		<p>
			{tips.length} curated tips — shortcuts, workflows, and hidden features from <span class="font-medium text-primary">Nirmal's Shell</span>, including when conditional tools and integrations show up.
		</p>
	</PageHeader>

	<div class="grid gap-4">
		<TipsExplorer client:visible tips={tips} />
	</div>
</Layout>

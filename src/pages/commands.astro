---
import Layout from '../layouts/Layout.astro';
import SearchCommands from '../components/SearchCommands.tsx';
import PageHeader from '../components/PageHeader.astro';
import { getCollection } from 'astro:content';

const commands = (await getCollection('commands')).map(({ data }) => data);
---

<Layout title="Commands" description={`Search ${commands.length} aliases, global aliases, and functions extracted from Nirmal's Zsh config.`}>
	<PageHeader title="Command Reference">
		<p>
			{commands.length} documented entries from <span class="font-medium text-primary">Nirmal's Shell</span>, with usage docs and feature notes extracted directly from the zsh sources.
		</p>
	</PageHeader>

	<div class="grid gap-4">

		<SearchCommands client:visible commands={commands} />
	</div>
</Layout>

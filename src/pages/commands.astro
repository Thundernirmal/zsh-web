---
import Layout from '../layouts/Layout.astro';
import SearchCommands from '../components/SearchCommands.tsx';
import PageHeader from '../components/PageHeader.astro';
import StatCard from '../components/StatCard.astro';
import { BracesIcon, FileCheck2Icon, SquareTerminalIcon } from 'lucide-react';
import commandsData from '../data/commands.json';

type Command = {
	type: string;
	usage?: string;
	availability?: string;
	features?: string[];
	examples?: string[];
	notes?: string[];
	requires?: string[];
	optional?: string[];
	interactive?: boolean;
	plainMode?: boolean;
	richOutput?: boolean;
};

const commands: Command[] = commandsData;
const functionCount = commands.filter((command) => command.type === 'function').length;
const hasItems = (items?: string[]) => (items?.length ?? 0) > 0;
const hasExtractedDetails = (command: Command) => {
	const listFields = [
		command.features,
		command.examples,
		command.notes,
		command.requires,
		command.optional,
	];
	const flagFields = [
		command.usage,
		command.availability,
		command.interactive,
		command.plainMode,
		command.richOutput,
	];

	return listFields.some((items) => hasItems(items)) || flagFields.some(Boolean);
};
const documentedCount = commands.filter((command) =>
	hasExtractedDetails(command),
).length;
---

<Layout title="Commands">
	<PageHeader title="Command Reference">
		<p>
			{commands.length} live entries synced from <span class="font-medium text-primary">Nirmal's Shell</span>, with usage docs and feature notes extracted directly from the zsh sources.
		</p>
	</PageHeader>

	<div class="grid gap-4">
		<div class="grid grid-cols-1 gap-2.5 motion-safe:animate-in motion-safe:fade-in sm:grid-cols-3">
			<StatCard value={commands.length} label="total commands" icon={SquareTerminalIcon} />
			<StatCard value={functionCount} label="custom functions" icon={BracesIcon} />
			<StatCard value={documentedCount} label="entries with extracted details" icon={FileCheck2Icon} />
		</div>

		<SearchCommands client:load />
	</div>
</Layout>

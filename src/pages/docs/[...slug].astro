---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import DocsLayout from '@/layouts/DocsLayout.astro';
import { validateGuideSlugs } from '@/lib/guide-topics.mjs';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  validateGuideSlugs(entries.map((entry) => entry.id));
  return entries.map((entry) => ({
    params: { slug: entry.id === 'index' ? undefined : entry.id },
    props: { entry },
  }));
}
interface Props { entry: CollectionEntry<'docs'> }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout title={entry.data.title} description={entry.data.description} slug={entry.id} headings={headings}>
  <Content />
</DocsLayout>
